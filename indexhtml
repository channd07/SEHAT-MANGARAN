<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#111B2E">
<title>Scan Absensi | SEHAT Mangaran</title>

<script defer src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400..700,0..1,0&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box}
:root{--blue:#3778F6;--bg:#080D16;--panel:#111B2E;--muted:#AEBBD0;--ok:#16A15A;--err:#E23955}
html,body{margin:0;width:100%;height:100%;font-family:Roboto,Arial,sans-serif;background:var(--bg);color:#fff}
body{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:12px}
.shell{position:relative;width:min(100%,540px);height:min(96dvh,820px);display:flex;flex-direction:column;overflow:hidden;border-radius:28px;background:#0A101B;box-shadow:0 24px 70px rgba(0,0,0,.42)}
.head{min-height:74px;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--panel);border-bottom:1px solid rgba(255,255,255,.1)}
.head b{display:block;font-size:18px}.head small{display:block;margin-top:3px;font-size:10px;color:var(--muted)}
.close{width:46px;height:46px;border:0;border-radius:15px;background:#263550;color:#fff;display:grid;place-items:center;cursor:pointer}
.stage{position:relative;flex:1;min-height:300px;background:#000;overflow:hidden}
#reader{width:100%;height:100%;min-height:100%;background:#000}
#reader video{width:100%!important;height:100%!important;object-fit:cover!important}
#reader__dashboard_section_swaplink,
#reader__dashboard_section_csr span,
#reader__status_span{display:none!important}
.guide{position:absolute;z-index:5;left:50%;top:50%;transform:translate(-50%,-50%);width:min(72%,330px);aspect-ratio:1;border:3px solid rgba(255,255,255,.9);border-radius:26px;pointer-events:none;box-shadow:0 0 0 9999px rgba(0,0,0,.18)}
.guide:before,.guide:after{content:"";position:absolute;width:55px;height:55px}
.guide:before{left:-4px;top:-4px;border-left:7px solid var(--blue);border-top:7px solid var(--blue);border-radius:21px 0 0 0}
.guide:after{right:-4px;bottom:-4px;border-right:7px solid var(--blue);border-bottom:7px solid var(--blue);border-radius:0 0 21px 0}
.foot{padding:12px 14px 15px;background:var(--panel)}
.status{min-height:48px;padding:10px 12px;border-radius:14px;background:#1C2940;color:#DCE6F6;display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;font-weight:700;line-height:1.35}
.status.busy{background:#24345A;color:#B4C9FF}.status.ok{background:#123B2C;color:#8EF0BD}.status.err{background:#481D28;color:#FFABBC;flex-direction:column;gap:7px}
.retry{border:0;border-radius:11px;background:var(--blue);color:#fff;padding:9px 14px;font-weight:800}
.result{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.58);opacity:0;visibility:hidden;pointer-events:none;transition:.15s}
.result.show{opacity:1;visibility:visible;pointer-events:auto}
.result-card{width:min(100%,360px);padding:23px 18px 18px;border-radius:25px;background:#fff;color:#17212B;text-align:center;box-shadow:0 22px 55px rgba(0,0,0,.3)}
.result-icon{width:66px;height:66px;margin:0 auto 11px;border-radius:21px;display:grid;place-items:center}
.result.success .result-icon{background:#E8F8EF;color:var(--ok)}.result.error .result-icon{background:#FFF0F2;color:var(--err)}
.result-icon span{font-size:40px;font-variation-settings:'FILL' 1,'wght' 650}
.result h3{margin:0;font-size:19px}.result p{margin:8px 0;font-size:12px;line-height:1.45;color:#65717E}
.detail{margin:10px 0 16px;font-size:12px;line-height:1.5;color:#475360}
.okbtn{width:100%;min-height:48px;border:0;border-radius:15px;background:var(--blue);color:#fff;font-size:14px;font-weight:800;cursor:pointer}
.session-error{padding:24px;text-align:center}
@media(max-width:560px){body{padding:0}.shell{width:100%;height:100dvh;border-radius:0}.guide{width:min(74vw,310px)}}
</style>
</head>

<body>
<div class="shell">
  <div class="head">
    <div>
      <b>Scan QR Absensi</b>
      <small id="userLabel">Memeriksa sesi scanner...</small>
    </div>
    <button class="close" type="button" onclick="stopAndClose()" aria-label="Tutup">
      <span class="material-symbols-rounded">close</span>
    </button>
  </div>

  <div class="stage">
    <div id="reader"></div>
    <div class="guide"></div>
  </div>

  <div class="foot">
    <div id="status" class="status">Menyiapkan scanner...</div>
  </div>

  <div id="result" class="result">
    <div class="result-card">
      <div class="result-icon"><span id="resultIcon" class="material-symbols-rounded">check_circle</span></div>
      <h3 id="resultTitle">ABSENSI BERHASIL</h3>
      <p id="resultMessage"></p>
      <div id="resultDetail" class="detail"></div>
      <button class="okbtn" type="button" onclick="resultOk()">OK</button>
    </div>
  </div>
</div>

<script>
const PARAMS=new URLSearchParams(location.search);
const ENDPOINT=String(PARAMS.get('endpoint')||'').trim();
const TOKEN=String(PARAMS.get('token')||'').trim();

let scanner=null;
let running=false;
let locked=true;
let lastCode='';
let lastAt=0;
let jsonpSeq=0;

function setStatus(msg,cls){
  const el=document.getElementById('status');
  el.className='status'+(cls?' '+cls:'');
  el.textContent=msg;
}

function jsonp(api,params){
  return new Promise((resolve,reject)=>{
    if(!ENDPOINT) return reject(new Error('Endpoint Apps Script tidak tersedia.'));

    const callback='__sehatJsonp'+Date.now()+'_'+(++jsonpSeq);
    const script=document.createElement('script');
    const query=new URLSearchParams(Object.assign({},params||{},{
      api:api,
      callback:callback,
      _:Date.now()
    }));

    const timer=setTimeout(()=>{
      cleanup();
      reject(new Error('Backend tidak merespons.'));
    },15000);

    function cleanup(){
      clearTimeout(timer);
      try{delete window[callback]}catch(e){}
      try{script.remove()}catch(e){}
    }

    window[callback]=data=>{
      cleanup();
      resolve(data);
    };

    script.onerror=()=>{
      cleanup();
      reject(new Error('Gagal menghubungi backend Apps Script.'));
    };

    script.src=ENDPOINT+(ENDPOINT.includes('?')?'&':'?')+query.toString();
    document.head.appendChild(script);
  });
}

function showResult(r){
  const ok=!!(r&&r.ok);
  const modal=document.getElementById('result');
  modal.className='result show '+(ok?'success':'error');
  document.getElementById('resultIcon').textContent=ok?'check_circle':'cancel';
  document.getElementById('resultTitle').textContent=ok?'ABSENSI BERHASIL':'ABSENSI GAGAL';
  document.getElementById('resultMessage').textContent=String(r&&r.message?r.message:(ok?'Absensi berhasil dicatat.':'Absensi gagal dicatat.'));

  const detail=document.getElementById('resultDetail');
  detail.innerHTML='';

  if(r&&r.pegawai){
    const a=document.createElement('div');
    a.textContent='Nama: '+r.pegawai;
    detail.appendChild(a);
  }
  if(r&&r.jam){
    const b=document.createElement('div');
    b.textContent='Waktu: '+r.jam;
    detail.appendChild(b);
  }
}

function resultOk(){
  document.getElementById('result').classList.remove('show');

  /* Kamera tidak pernah dihentikan selama popup hasil tampil.
     Tombol OK hanya membuka lock pembacaan QR kembali. */
  locked=false;
  lastAt=Date.now();
  setStatus('Kamera aktif • siap scan berikutnya','');
}

async function decoded(text){
  const value=String(text||'').trim();
  const now=Date.now();

  if(!value||locked) return;
  if(value===lastCode && now-lastAt<1800) return;

  locked=true;
  lastCode=value;
  lastAt=now;
  setStatus('QR terbaca • memproses absensi...','busy');

  let result;
  try{
    result=await jsonp('scan',{token:TOKEN,qr:value});
  }catch(e){
    result={ok:false,message:e&&e.message?e.message:String(e||'Gagal memproses absensi.')};
  }

  setStatus(result&&result.ok?'Absensi berhasil':'Absensi gagal',result&&result.ok?'ok':'err');
  showResult(result);

  if(result && result.code==='SESSION_EXPIRED'){
    locked=true;
  }
}

async function startCamera(){
  if(running) return;

  if(!window.isSecureContext){
    setStatus('Scanner harus dibuka melalui HTTPS.','err');
    return;
  }
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){
    setStatus('Browser tidak menyediakan akses kamera.','err');
    return;
  }
  if(typeof Html5Qrcode==='undefined'){
    setStatus('Library scanner belum siap. Muat ulang halaman.','err');
    return;
  }

  setStatus('Mengaktifkan kamera...','busy');

  try{
    scanner=new Html5Qrcode('reader',{
      formatsToSupport:(typeof Html5QrcodeSupportedFormats!=='undefined')?[Html5QrcodeSupportedFormats.QR_CODE]:undefined,
      verbose:false
    });

    const config={
      fps:20,
      qrbox:(w,h)=>{const s=Math.floor(Math.min(w,h)*.72);return{width:s,height:s}},
      aspectRatio:1.333334,
      disableFlip:false
    };

    let started=false,lastErr=null;

    try{
      await scanner.start({facingMode:{ideal:'environment'}},config,decoded,()=>{});
      started=true;
    }catch(e){lastErr=e}

    if(!started){
      try{await scanner.clear()}catch(e){}
      scanner=new Html5Qrcode('reader',{verbose:false});
      try{
        await scanner.start({facingMode:'user'},config,decoded,()=>{});
        started=true;
      }catch(e){lastErr=e}
    }

    if(!started){
      try{await scanner.clear()}catch(e){}
      scanner=new Html5Qrcode('reader',{verbose:false});
      const cams=await Html5Qrcode.getCameras();
      if(!cams||!cams.length) throw lastErr||new Error('Tidak ada perangkat kamera.');
      const rear=cams.find(c=>/back|rear|environment|belakang/i.test(c.label||''));
      await scanner.start((rear||cams[0]).id,config,decoded,()=>{});
      started=true;
    }

    if(!started) throw lastErr||new Error('Kamera gagal dimulai.');

    running=true;
    locked=false;
    setStatus('Kamera aktif • arahkan QR ke kotak','');

  }catch(e){
    running=false;
    const msg=e&&e.message?e.message:String(e||'Kamera gagal dibuka.');
    const el=document.getElementById('status');
    el.className='status err';
    el.innerHTML='<b>Kamera gagal dibuka: '+escapeHtml(msg)+'</b><button class="retry" type="button" onclick="retryCamera()">Coba Lagi</button>';
  }
}

function escapeHtml(s){
  return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
}

async function retryCamera(){
  try{
    if(scanner&&running)await scanner.stop();
  }catch(e){}
  try{if(scanner)await scanner.clear()}catch(e){}
  scanner=null;
  running=false;
  setTimeout(startCamera,120);
}

async function stopAndClose(){
  locked=true;
  try{if(scanner&&running)await scanner.stop()}catch(e){}
  try{if(scanner)await scanner.clear()}catch(e){}
  window.close();
}

async function init(){
  if(!ENDPOINT||!TOKEN){
    setStatus('Parameter sesi scanner tidak lengkap. Buka scanner dari aplikasi SEHAT Mangaran.','err');
    return;
  }

  try{
    const check=await jsonp('scanner-check',{token:TOKEN});
    if(!check||!check.ok){
      setStatus(check&&check.message?check.message:'Sesi scanner tidak valid.','err');
      return;
    }

    document.getElementById('userLabel').textContent=(check.nama||check.username||'Pengguna')+' • Scanner aktif';

    const wait=()=>{
      if(typeof Html5Qrcode!=='undefined') startCamera();
      else setTimeout(wait,100);
    };
    wait();

  }catch(e){
    setStatus(e&&e.message?e.message:String(e||'Gagal memeriksa sesi scanner.'),'err');
  }
}

window.addEventListener('load',init);
window.addEventListener('beforeunload',()=>{try{if(scanner&&running)scanner.stop()}catch(e){}});
</script>
</body>
</html>
